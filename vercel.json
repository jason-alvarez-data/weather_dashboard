{
  "version": 2,
  "builds": [
    {
      "src": "minimal_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/minimal_app.py"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "functions": {
    "minimal_app.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
} 